<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<Script file="TalentStage.lua"/>

	<Frame name="TalentStageFrame" toplevel="true" parent="UIParent" hidden="true" enableMouse="true" movable="true" frameStrata="HIGH">
		<Size>
			<AbsDimension x="200" y="200"/>
		</Size>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Frames>
			<Button name="TalentStageCloseButton" inherits="UIPanelCloseButton">
				<Anchors>
					<Anchor point="TOPRIGHT">
						<Offset>
							<AbsDimension x="-4" y="-4"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						TalentStageFrame:Hide();
					</OnClick>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad>
				TalentStageFrame_OnLoad();
			</OnLoad>
			<OnEvent>
				TalentStageFrame_OnEvent();
			</OnEvent>
			<OnShow>
				TalentStageFrame_OnShow();
			</OnShow>
			<OnHide>
				TalentStageFrame_OnHide();
			</OnHide>
			<OnDragStart>
				this:StartMoving();
			</OnDragStart>
			<OnDragStop>
				this:StopMovingOrSizing();
			</OnDragStop>
		</Scripts>
	</Frame>
</Ui>
